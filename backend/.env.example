# SID_Talkies Backend Configuration
PROJECT_NAME="SID_Talkies Backend"
ENVIRONMENT="development"
DEBUG=true

# Database: SQLite for development, PostgreSQL for production
# e.g., postgresql+psycopg2://user:password@localhost:5432/sid_talkies
DATABASE_URL="sqlite:///./sid_talkies.db"

# JWT Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# AI Provider Configuration
# Options: "gemini", "openai", "mock"
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Web Search Provider
# Options: "mock", "tavily", "serper"
SEARCH_PROVIDER="mock"
SEARCH_API_KEY=""

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
DAILY_RESEARCH_LIMIT=20
DAILY_CHAT_LIMIT=200
